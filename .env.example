# Copy to .env and fill in real values before running docker-compose
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
JWT_SECRET=replace-with-a-random-64-char-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-string
FRONTEND_URL=http://your-ec2-public-ip-or-domain
